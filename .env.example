# 模型选择，支持 openai: / anthropic: 前缀
# 千问走 OpenAI 兼容协议，所以前缀保持 openai:
AGENT_MODEL=openai:qwen3.8-max-0902
AGENT_WORKSPACE=.

# 千问 API Key（阿里云百炼控制台获取）
OPENAI_API_KEY=sk-...

# 千问 OpenAI 兼容端点
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ANTHROPIC_API_KEY=sk-ant-...   # 不用千问时保持注释
LOG_LEVEL=INFO

# JSON 格式输出（生产环境建议 true，便于日志聚合）
LOG_JSON=false

# 上游 trace_id 透传头（默认 X-Trace-Id）
# AGENT_TRACE_HEADER=X-Trace-Id

# LangSmith（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=coding-agent

# ============================================================
# 安全
# ============================================================

# 幂等性中间件（默认 true）
AGENT_IDEMPOTENCY=true

# 工具审批（默认 true）
AGENT_APPROVAL=true
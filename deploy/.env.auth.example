# ============================================================
# 认证配置
# ============================================================

# 认证模式：mock | oidc | disabled
# - mock: 开发用，预设 token
# - oidc: 生产用，验证 JWT
# - disabled: 完全关闭认证（仅本地开发）
AUTH_MODE=mock

# 是否强制认证。生产必须 true
REQUIRE_AUTH=true

# ---------- OIDC 配置（AUTH_MODE=oidc 时生效）----------

# Issuer URL，如 https://keycloak.company.com/realms/myrealm
OIDC_ISSUER=

# 期望的 audience（JWT 的 aud 声明）
OIDC_AUDIENCE=coding-agent

# JWKS 端点，通常为 {OIDC_ISSUER}/protocol/openid-connect/certs
OIDC_JWKS_URL=

# 前端 OIDC 客户端配置
OIDC_CLIENT_ID=coding-agent-frontend
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPE=openid profile email
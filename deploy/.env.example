# ============ 模型配置 ============
AGENT_MODEL=openai:qwen3.8-max-0902
AGENT_MODEL_WINDOW=200000

# ============ API 密钥 ============
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============ 工作区 ============
# 被操作项目的路径（宿主机绝对路径）
WORKSPACE_PATH=/path/to/your/project

# ============ 可观测性 ============
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=coding-agent

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_JSON=true